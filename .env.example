# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-loan-management-system-secret-key-replace-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver,web

# Database Settings (PostgreSQL Docker Desktop)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=loan_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5433

# Development Database Switch
# Set USE_SQLITE=True to run with local SQLite without Docker PostgreSQL
USE_SQLITE=False

# Language & Localization
LANGUAGE_CODE=km
TIME_ZONE=Asia/Phnom_Penh
USE_I18N=True
USE_TZ=True
